{
  "name": "@shajara/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "yarn run -T tsc --noEmit"
  },
  "dependencies": {
    "@shajara/kernel": "workspace:^"
  },
  "devDependencies": {
    "@shajara/presets": "workspace:^",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
