{
  "name": "@khora/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    },
    "./scopes": {
      "types": "./dist/scopes/index.d.ts",
      "import": "./dist/scopes.js",
      "require": "./dist/scopes.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "yarn run -T tsc"
  },
  "dependencies": {
    "fp-ts": "^2.16.11"
  },
  "devDependencies": {
    "@khora/presets": "workspace:^",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
