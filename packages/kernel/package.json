{
  "name": "@shajara/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sigils": {
      "types": "./dist/sigils.d.ts",
      "import": "./dist/sigils.js",
      "require": "./dist/sigils.cjs"
    },
    "./syscalls": {
      "types": "./dist/syscalls.d.ts",
      "import": "./dist/syscalls.js",
      "require": "./dist/syscalls.cjs"
    },
    "./scopes": {
      "types": "./dist/scopes.d.ts",
      "import": "./dist/scopes.js",
      "require": "./dist/scopes.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "yarn run -T tsc --noEmit"
  },
  "dependencies": {
    "defaults": "^3.0.0",
    "fp-ts": "^2.16.11"
  },
  "devDependencies": {
    "@shajara/presets": "workspace:^",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
