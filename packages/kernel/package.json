{
  "name": "@shajara/kernel",
  "version": "0.3.0",
  "description": "Structured concurrency kernel and executor primitives.",
  "keywords": [
    "concurrency",
    "executor",
    "kernel",
    "runtime",
    "shajara",
    "structured-concurrency"
  ],
  "homepage": "https://github.com/iplaylf2/shajara#readme",
  "bugs": {
    "url": "https://github.com/iplaylf2/shajara/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "iplaylf2",
    "url": "https://github.com/iplaylf2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iplaylf2/shajara.git",
    "directory": "packages/kernel"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./sigils": {
      "import": "./dist/sigils.js",
      "require": "./dist/sigils.cjs",
      "types": "./dist/sigils.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs",
      "types": "./dist/utils.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "postpack": "yarn run -T pack:license clean",
    "prepack": "yarn build && yarn run -T pack:license stage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@shajara/presets": "workspace:^",
    "@vitest/coverage-v8": "catalog:",
    "core-js": "catalog:",
    "fp-ts": "^2.16.11",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
