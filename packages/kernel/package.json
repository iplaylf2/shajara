{
  "name": "@shajara/kernel",
  "version": "0.1.0",
  "description": "Structured concurrency semantics kernel for shajara.",
  "homepage": "https://github.com/iplaylf2/shajara#readme",
  "bugs": {
    "url": "https://github.com/iplaylf2/shajara/issues"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iplaylf2/shajara.git",
    "directory": "packages/kernel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./sigils": {
      "import": "./dist/sigils.js",
      "require": "./dist/sigils.cjs",
      "types": "./dist/sigils.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs",
      "types": "./dist/utils.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "yarn run -T tsc --noEmit && yarn run -T tsc -p test/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@shajara/presets": "workspace:^",
    "@vitest/coverage-v8": "catalog:",
    "fp-ts": "^2.16.11",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
