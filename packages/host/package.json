{
  "name": "@shajara/host",
  "version": "0.10.2",
  "description": "Structured concurrency orchestration for JavaScript applications.",
  "keywords": [
    "async",
    "concurrency",
    "generator",
    "runtime",
    "shajara",
    "structured-concurrency"
  ],
  "homepage": "https://iplaylf2.github.io/shajara",
  "bugs": {
    "url": "https://github.com/iplaylf2/shajara/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "iplaylf2",
    "url": "https://github.com/iplaylf2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iplaylf2/shajara.git",
    "directory": "packages/host"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs",
      "types": "./dist/primitives.d.ts"
    },
    "./boundary": {
      "import": "./dist/boundary.js",
      "require": "./dist/boundary.cjs",
      "types": "./dist/boundary.d.ts"
    }
  },
  "scripts": {
    "api-map": "typedoc",
    "build": "vite build",
    "postpack": "yarn run -T pack:license clean",
    "prepack": "yarn build && yarn run -T pack:license stage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shajara/kernel": "workspace:^"
  },
  "devDependencies": {
    "@shajara/presets": "workspace:^",
    "@vitest/coverage-v8": "catalog:",
    "core-js": "catalog:",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
