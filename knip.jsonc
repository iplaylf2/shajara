{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "exclude": ["namespaceMembers"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  // Referenced by .dependency-cruiser.json's `extends`, which Knip does not resolve.
  "ignoreDependencies": ["dependency-cruiser"],
  "tags": ["-preserveSurface"],
}
