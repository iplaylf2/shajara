{
  "name": "@shajara/docs",
  "version": "0.6.1",
  "private": true,
  "description": "Documentation and demo app for shajara.",
  "homepage": "https://iplaylf2.github.io/shajara",
  "author": {
    "name": "iplaylf2",
    "url": "https://github.com/iplaylf2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iplaylf2/shajara.git",
    "directory": "apps/docs"
  },
  "type": "module",
  "scripts": {
    "api-map": "typedoc",
    "brand-assets": "node -e \"const { copyFileSync, mkdirSync } = require('node:fs'); const { dirname } = require('node:path'); const target = 'public/favicon.svg'; mkdirSync(dirname(target), { recursive: true }); copyFileSync(require.resolve('@shajara/brand/favicon.svg'), target);\"",
    "build": "pnpm api-map && pnpm brand-assets && pnpm build:site",
    "build:site": "astro build",
    "dev": "astro dev --host",
    "preview": "astro preview --host",
    "test": "node -e \"console.log('No tests for @shajara/docs')\"",
    "typecheck": "astro-check"
  },
  "dependencies": {
    "@shajara/host": "workspace:^",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/solid-js": "^6.0.1",
    "@astrojs/starlight": "^0.40.0",
    "@shajara/brand": "workspace:^",
    "@shajara/presets": "workspace:^",
    "astro": "^6.4.8",
    "oxlint": "catalog:",
    "type-fest": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  }
}
