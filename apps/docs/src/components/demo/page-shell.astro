---
import { I18N } from "#site";

interface Props {
  docsHref: string;
  intro: string;
  title: string;
}

const { docsHref, intro, title } = Astro.props;
const lang = Astro.currentLocale ?? I18N.locales[I18N.defaultLocale].lang;
const dir = Astro.locals.t.dir();
---

<!doctype html>
<html dir={dir} lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{title}</title>
    <style>
      :root {
        color: #111827;
        background:
          radial-gradient(circle at top, #fef3c7 0, transparent 28%),
          linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
        font-family:
          "Iowan Old Style", "Palatino Linotype", "URW Palladio L", serif;
      }

      body {
        margin: 0;
      }

      main {
        box-sizing: border-box;
        display: grid;
        gap: 1.5rem;
        margin: 0 auto;
        max-width: 48rem;
        min-height: 100vh;
        padding: 4rem 1.5rem;
        place-content: center;
      }

      header {
        display: grid;
        gap: 0.75rem;
      }

      h1,
      p {
        margin: 0;
      }

      .eyebrow {
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .surface {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(17, 24, 39, 0.08);
        border-radius: 1.5rem;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
        padding: 1.5rem;
      }

      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main>
      <p><a href={docsHref}>{Astro.locals.t("demo.shell.backToDocs")}</a></p>
      <header>
        <p class="eyebrow">{Astro.locals.t("demo.shell.eyebrow")}</p>
        <h1>{title}</h1>
        <p>{intro}</p>
      </header>
      <section class="surface">
        <slot />
      </section>
    </main>
  </body>
</html>
