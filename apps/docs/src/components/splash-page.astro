---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const { body, description, heroActions, tagline, title } = Astro.props;
const frontmatter = {
  description,
  hero: {
    actions: heroActions,
    tagline,
  },
  template: "splash" as const,
  title,
};

type HeroAction = {
  attrs?: {
    iconPlacement?: "start" | "end";
  };
  icon: "document" | "open-book" | "right-arrow" | "window";
  link: string;
  text: string;
  variant?: "primary" | "secondary" | "minimal";
};

interface Props {
  body: string;
  description: string;
  heroActions?: HeroAction[];
  tagline?: string;
  title: string;
}
---

<StarlightPage frontmatter={frontmatter}>
  <p>{body}</p>
</StarlightPage>
