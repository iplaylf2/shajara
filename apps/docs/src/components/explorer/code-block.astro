---
import type {
  ExplorerEventId,
  ExplorerExampleCodeEntry,
} from "#/domain/explorer/contract";
import { Code } from "astro/components";
import { isExplorerExampleCodeLine } from "#/domain/explorer/contract";
import styles from "./styles.module.css";

const { code, id } = Astro.props;
const source = code.map((line) => line.text).join("\n");
const FIRST_LINE = 1;
const lineTransformer = {
  line(node: { properties: object }, lineNumber: number) {
    const line = code.at(lineNumber - FIRST_LINE);

    if (!line) {
      return;
    }

    const className = [styles["explorerCodeLine"]];

    if (!isExplorerExampleCodeLine(line)) {
      className.push(styles["explorerCodeSpacer"]);
      Object.assign(node.properties, { class: className.join(" ") });
      return;
    }

    const lineEvent = line.id;
    const completedEvents = line.completion.events;

    Object.assign(node.properties, {
      class: className.join(" "),
      "data-explorer-completed-events": completedEvents.join(" "),
      "data-explorer-line-event": lineEvent,
    });
  },
  name: "explorer-code-lines",
};

interface Props {
  code: readonly ExplorerExampleCodeEntry<ExplorerEventId>[];
  id: string;
}

---

<Code
  code={source}
  class={styles["explorerCode"]}
  data-explorer-code
  id={id}
  lang="ts"
  theme="css-variables"
  transformers={[lineTransformer]}
/>
