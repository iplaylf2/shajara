---
import type {
  ExplorerEventId,
  ExplorerExampleCodeLine,
} from "#/domain/explorer/contract";
import { Code } from "astro/components";
import styles from "./explorer.module.css";

const { code, id } = Astro.props;
const source = code.map((line) => line.text).join("\n");
const firstLine = 1;
const lineTransformer = {
  line(node: CodeLineNode, lineNumber: number) {
    const line = code.at(lineNumber - firstLine);

    if (!line) {
      return;
    }

    const lineEvent = line.id;
    const completedEvents = line.completedEvents ?? [];

    const className = [styles["explorerCodeLine"]];

    node.properties ??= {};
    node.properties["class"] = className.join(" ");
    node.properties["data-explorer-line-event"] = lineEvent;
    node.properties["data-explorer-completed-events"] =
      completedEvents.join(" ");
  },
  name: "explorer-code-lines",
};

interface Props {
  code: readonly ExplorerExampleCodeLine<ExplorerEventId>[];
  id: string;
}

interface CodeLineNode {
  properties?: CodeLineProperties;
}

interface CodeLineProperties {
  class?: string;
  "data-explorer-completed-events"?: string;
  "data-explorer-line-event"?: ExplorerEventId;
}
---

<Code
  code={source}
  class={styles["explorerCode"]}
  data-explorer-code
  id={id}
  lang="ts"
  theme="css-variables"
  transformers={[lineTransformer]}
/>
