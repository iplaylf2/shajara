---
import ExplorerCodeBlock from "./explorer-code-block.astro";
import type { ExplorerExampleDefinition } from "#/domain/explorer/examples";
import { ExplorerReplayDemo } from "./explorer-replay-demo";
import { resolveExplorerFlowScene } from "./explorer-flow-scene";
import styles from "./explorer.module.css";

const { description, example, guideRows, title } = Astro.props;
const codeBlockId = `explorer-${example.id}-code`;
const stageEventIds = [
  ...new Set(
    example.stage.code.flatMap((line) => [
      line.id,
      ...line.completion.events,
    ]),
  ),
];
const stage = {
  eventIds: stageEventIds,
  replay: {
    replayDelayMs: example.stage.replay.replayDelayMs,
  },
  scene: resolveExplorerFlowScene(example.stage.flow, `${title} flow`),
};

interface Props {
  description: string;
  example: ExplorerExampleDefinition;
  guideRows: readonly string[];
  title: string;
}
---

<section aria-labelledby="explorer-stage-title" class={styles["stagePanel"]}>
  <h2 class={styles["srOnly"]} id="explorer-stage-title">
    {title}
  </h2>

  <div class={styles["sceneHeader"]}>
    <p class={styles["sceneBody"]}>{description}</p>
  </div>

  <ExplorerReplayDemo
    client:load
    codeBlockId={codeBlockId}
    codeFollowLabel={Astro.locals.t("explorer.replay.follow")}
    codeManualLabel={Astro.locals.t("explorer.replay.manual")}
    exampleId={example.id}
    stage={stage}
  >
    <ExplorerCodeBlock code={example.stage.code} id={codeBlockId} />
  </ExplorerReplayDemo>

  <div class={styles["guideList"]}>
    {
      guideRows.map((row) => (
        <div class={styles["guideRow"]}>
          <span class={styles["guideMarker"]} />
          <div class={styles["guideTrack"]}>
            <span class={styles["guideText"]}>{row}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
