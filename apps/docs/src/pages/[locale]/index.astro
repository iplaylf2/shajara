---
import { i18N, siteLocales } from "#site";
import SplashPage from "#/components/splash-page.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
  return siteLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const siteBase = import.meta.env.BASE_URL.replace(/\/$/u, "");

const heroActions = [
  {
    icon: "right-arrow" as const,
    link: getRelativeLocaleUrl(
      i18N.locales[locale].lang,
      "guides/getting-started",
    ),
    text: Astro.locals.t("docs.home.hero.guides"),
  },
  {
    icon: "right-arrow" as const,
    link: getRelativeLocaleUrl(i18N.locales[locale].lang, "explorer"),
    text: Astro.locals.t("docs.home.hero.explorer"),
  },
  {
    icon: "right-arrow" as const,
    link: `${siteBase}/typedoc/index.html`,
    text: Astro.locals.t("docs.home.hero.typedoc"),
  },
];
---

<SplashPage
  body={Astro.locals.t("docs.home.body")}
  description={Astro.locals.t("docs.home.description")}
  heroActions={heroActions}
  tagline={Astro.locals.t("docs.home.hero.tagline")}
  title={Astro.locals.t("docs.home.title")}
/>
