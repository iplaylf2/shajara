---
import { i18N, site, siteLocales } from "#site";
import SplashPage from "#/components/splash-page.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
  return siteLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const explorerHref = getRelativeLocaleUrl(
  i18N.locales[locale].lang,
  "explorer",
);
const docsHref = getRelativeLocaleUrl(
  i18N.locales[locale].lang,
  "guides/getting-started",
);
const apiMapHref = `${site.basePath}/api-map/index.html`;

const heroActions = [
  {
    attrs: { iconPlacement: "start" as const },
    icon: "open-book" as const,
    link: docsHref,
    text: Astro.locals.t("docs.home.hero.docs"),
    variant: "primary" as const,
  },
  {
    attrs: { iconPlacement: "start" as const },
    icon: "window" as const,
    link: explorerHref,
    text: Astro.locals.t("docs.home.hero.explorer"),
    variant: "secondary" as const,
  },
  {
    attrs: { iconPlacement: "start" as const },
    icon: "document" as const,
    link: apiMapHref,
    text: Astro.locals.t("docs.home.hero.apiMap"),
    variant: "secondary" as const,
  },
];
---

<SplashPage
  description={Astro.locals.t("docs.home.description")}
  heroActions={heroActions}
  tagline={Astro.locals.t("docs.home.hero.tagline")}
  title={Astro.locals.t("docs.home.title")}
>
  <p>{Astro.locals.t("docs.home.body")}</p>
</SplashPage>
