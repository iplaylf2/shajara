---
import ExplorerLayout from "#/layouts/explorer-layout.astro";
import ExplorerView from "#/components/explorer/explorer-view";
import { SECONDARY_SITE_LOCALES } from "#site";
import { docsHomeLink } from "#/pages-kit/docs-home-link";
import { explorerExamplesZh } from "#/components/explorer/explorer-examples";

export function getStaticPaths() {
  return SECONDARY_SITE_LOCALES.map((locale) => ({ params: { locale } }));
}
---

<ExplorerLayout title={Astro.locals.t("explorer.home.title")}>
  <ExplorerView
    client:load
    brandHref={docsHomeLink(Astro.currentLocale)}
    brandLabel="shajara"
    examples={explorerExamplesZh}
    explorerLabel="探索"
  />
</ExplorerLayout>
