---
import { DEFAULT_EXPLORER_EXAMPLE_ID } from "#/pages-kit/explorer";
import { SITE_LOCALES } from "#site";
import type { SiteLocale } from "#site";

export function getStaticPaths() {
  return SITE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: SiteLocale };

const rewritePath = `/${locale}/explorer/${DEFAULT_EXPLORER_EXAMPLE_ID}`;

// oxlint-disable-next-line no-void
void rewritePath;

return Astro.rewrite(rewritePath);
---
