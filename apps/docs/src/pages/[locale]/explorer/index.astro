---
import { DEFAULT_EXPLORER_EXAMPLE_ID } from "#/components/explorer/explorer-content";
import ExplorerPage from "#/components/explorer/explorer-page.astro";
import { SITE_LOCALES } from "#site";
import type { SiteLocale } from "#site";

export function getStaticPaths() {
  return SITE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: SiteLocale };
---

<ExplorerPage currentExampleId={DEFAULT_EXPLORER_EXAMPLE_ID} locale={locale} />
