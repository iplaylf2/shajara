---
import {
  DEFAULT_EXPLORER_EXAMPLE_ID,
  ExplorerBody,
} from "#/pages-kit/explorer";
import ExplorerLayout from "#/layouts/explorer-layout.astro";
import { SITE_LOCALES } from "#site";
import type { SiteLocale } from "#site";

export function getStaticPaths() {
  return SITE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: SiteLocale };
---

<ExplorerLayout title={Astro.locals.t("explorer.home.title")}>
  <ExplorerBody
    currentExampleId={DEFAULT_EXPLORER_EXAMPLE_ID}
    locale={locale}
  />
</ExplorerLayout>
