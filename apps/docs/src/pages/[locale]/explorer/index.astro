---
import { DEFAULT_EXPLORER_EXAMPLE_ID } from "#/domain/explorer/examples";
import { siteLocales } from "#site";

export function getStaticPaths() {
  return siteLocales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const rewritePath = `/${locale}/explorer/${DEFAULT_EXPLORER_EXAMPLE_ID}`;

// oxlint-disable-next-line no-void
void rewritePath;

return Astro.rewrite(rewritePath);
---
