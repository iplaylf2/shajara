---
import {
  ExplorerExampleRail,
  ExplorerExampleStage,
  ExplorerShell,
} from "#/components/explorer";
import {
  buildExplorerHref,
  buildExplorerLocaleLinks,
} from "#/pages-kit/explorer";
import {
  explorerExamples,
  readExplorerExample,
} from "#/domain/explorer/examples";
import { i18N, siteLocales } from "#site";
import type { ExplorerExampleDefinition } from "#/domain/explorer/examples";
import type { ExplorerExampleSummary } from "#/pages-kit/explorer";
import ExplorerLayout from "#/layouts/explorer-layout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
  return siteLocales.flatMap((locale) =>
    explorerExamples.map((exampleDefinition) => ({
      params: { example: exampleDefinition.id, locale },
    })),
  );
}

const { example, locale } = Astro.params;

function buildExplorerExampleSummary(
  entry: ExplorerExampleDefinition,
): ExplorerExampleSummary {
  return {
    description: Astro.locals.t(entry.descriptionKey),
    guideRows: entry.guideKeys.map((key) => Astro.locals.t(key)),
    href: buildExplorerHref(locale, entry.id),
    id: entry.id,
    title: Astro.locals.t(entry.titleKey),
  };
}

const exampleDefinition = readExplorerExample(example);
const examples = explorerExamples.map(buildExplorerExampleSummary);
const currentExample = buildExplorerExampleSummary(exampleDefinition);
const chrome = {
  brandHref: getRelativeLocaleUrl(i18N.locales[locale].lang),
  brandLabel: "shajara",
  currentLocaleLabel: i18N.locales[locale].label,
  explorerLabel: Astro.locals.t("explorer.shell.eyebrow"),
  localeLinks: buildExplorerLocaleLinks(currentExample.id),
  title: currentExample.title,
};
const pageTitle = `${currentExample.title} · ${Astro.locals.t("explorer.home.title")}`;
const replayLabels = {
  codeFollow: Astro.locals.t("explorer.replay.follow"),
  codeManual: Astro.locals.t("explorer.replay.manual"),
};
---

<ExplorerLayout locale={locale} title={pageTitle}>
  <ExplorerShell chrome={chrome}>
    <ExplorerExampleStage
      content={currentExample}
      definition={exampleDefinition}
      replayLabels={replayLabels}
    />
    <ExplorerExampleRail
      currentExampleId={currentExample.id}
      examples={examples}
    />
  </ExplorerShell>
</ExplorerLayout>
