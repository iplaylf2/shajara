---
import {
  EXPLORER_EXAMPLE_IDS,
  ExplorerBody,
  isExplorerExampleId,
} from "#/pages-kit/explorer";
import ExplorerLayout from "#/layouts/explorer-layout.astro";
import { SITE_LOCALES } from "#site";
import type { SiteLocale } from "#site";

export function getStaticPaths() {
  return SITE_LOCALES.flatMap((locale) =>
    EXPLORER_EXAMPLE_IDS.map((example) => ({
      params: { example, locale },
    })),
  );
}

const { example, locale } = Astro.params as {
  example: string;
  locale: SiteLocale;
};

if (!isExplorerExampleId(example)) {
  throw new Error(`Unknown explorer example: ${example}`);
}
---

<ExplorerLayout title={Astro.locals.t("explorer.home.title")}>
  <ExplorerBody currentExampleId={example} locale={locale} />
</ExplorerLayout>
