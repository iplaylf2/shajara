---
import { ExplorerExampleRail, ExplorerTopbar } from "#/components/explorer";
import {
  buildExplorerHref,
  buildExplorerLocaleLinks,
} from "#/pages-kit/explorer";
import {
  explorerExamples,
  readExplorerExample,
} from "#/domain/explorer/examples";
import { i18N, siteLocales } from "#site";
import type { ExplorerBodyExample } from "#/pages-kit/explorer";
import type { ExplorerExampleDefinition } from "#/domain/explorer/examples";
import ExplorerExampleStage from "#/components/explorer/example-stage.astro";
import ExplorerLayout from "#/layouts/explorer-layout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import styles from "#/components/explorer/styles.module.css";

export function getStaticPaths() {
  return siteLocales.flatMap((locale) =>
    explorerExamples.map((exampleDefinition) => ({
      params: { example: exampleDefinition.id, locale },
    })),
  );
}

function buildExplorerExample(
  entry: ExplorerExampleDefinition,
): ExplorerBodyExample {
  return {
    description: Astro.locals.t(entry.descriptionKey),
    guideRows: entry.guideKeys.map((key) => Astro.locals.t(key)),
    href: buildExplorerHref(locale, entry.id),
    id: entry.id,
    title: Astro.locals.t(entry.titleKey),
  };
}

const { example, locale } = Astro.params;
const exampleDefinition = readExplorerExample(example);

const examples: ExplorerBodyExample[] =
  explorerExamples.map(buildExplorerExample);
const currentExample = buildExplorerExample(exampleDefinition);
const docsHomeHref = getRelativeLocaleUrl(i18N.locales[locale].lang);
const localeLinks = buildExplorerLocaleLinks(currentExample.id);
const pageTitle = `${currentExample.title} · ${Astro.locals.t("explorer.home.title")}`;
---

<ExplorerLayout locale={locale} title={pageTitle}>
  <div class={styles["root"]}>
    <ExplorerTopbar
      brandHref={docsHomeHref}
      brandLabel="shajara"
      currentLocaleLabel={i18N.locales[locale].label}
      explorerLabel={Astro.locals.t("explorer.shell.eyebrow")}
      localeLinks={localeLinks}
      title={currentExample.title}
    />

    <section class={styles["surface"]}>
      <div class={styles["contentGrid"]}>
        <ExplorerExampleStage
          description={currentExample.description}
          example={exampleDefinition}
          guideRows={currentExample.guideRows}
          title={currentExample.title}
        />
        <ExplorerExampleRail
          currentExampleId={currentExample.id}
          examples={examples}
        />
      </div>
    </section>
  </div>
</ExplorerLayout>
