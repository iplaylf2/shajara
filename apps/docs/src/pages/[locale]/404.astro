---
import { siteLocales } from "#site";
import SplashPage from "#/components/splash-page.astro";

export function getStaticPaths() {
  return siteLocales.map((locale) => ({ params: { locale } }));
}
---

<SplashPage
  body={Astro.locals.t("docs.404.body")}
  description={Astro.locals.t("docs.404.description")}
  title={Astro.locals.t("docs.404.title")}
/>
