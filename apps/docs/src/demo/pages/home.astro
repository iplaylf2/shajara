---
import Counter from "#/demo/components/counter";
import DemoPageShell from "#/demo/layouts/page-shell.astro";
import type { SiteLocale } from "#site";
import { docsHomeLink } from "#site";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
---

<DemoPageShell
  docsHref={docsHomeLink(locale)}
  intro={Astro.locals.t("demo.home.intro")}
  title={Astro.locals.t("demo.home.title")}
>
  <Counter
    buttonLabel={Astro.locals.t("demo.counter.button")}
    client:load
    countLabel={Astro.locals.t("demo.counter.countLabel")}
  />
</DemoPageShell>
