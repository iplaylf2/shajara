---
import {
  DEFAULT_EXPLORER_EXAMPLE_ID,
  type ExplorerExampleId,
  buildExplorerExamples,
  buildExplorerLocaleLinks,
} from "./content";
import {
  ExplorerCodePanel,
  ExplorerExampleRail,
  ExplorerStagePanel,
  ExplorerTopbar,
} from "#/components/explorer";
import type { SiteLocale } from "#site";
import { docsHomeLink } from "#/pages-kit/docs-home-link";
import styles from "#/components/explorer/explorer.module.css";

const { currentExampleId = DEFAULT_EXPLORER_EXAMPLE_ID, locale } =
  Astro.props as {
    currentExampleId?: ExplorerExampleId;
    locale: SiteLocale;
  };
const examples = buildExplorerExamples({
  descriptions: {
    "example-a": Astro.locals.t("explorer.examples.example-a.description"),
    "example-b": Astro.locals.t("explorer.examples.example-b.description"),
    "example-c": Astro.locals.t("explorer.examples.example-c.description"),
  },
  locale,
  titles: {
    "example-a": Astro.locals.t("explorer.examples.example-a.title"),
    "example-b": Astro.locals.t("explorer.examples.example-b.title"),
    "example-c": Astro.locals.t("explorer.examples.example-c.title"),
  },
});
const fallbackExample = examples.find(
  (example) => example.id === DEFAULT_EXPLORER_EXAMPLE_ID,
)!;
const currentExample =
  examples.find((example) => example.id === currentExampleId) ??
  fallbackExample;
const localeLinks = buildExplorerLocaleLinks(currentExample.id, locale);
---

<div class={styles["root"]}>
  <ExplorerTopbar
    brandHref={docsHomeLink(locale)}
    brandLabel="shajara"
    explorerLabel={Astro.locals.t("explorer.shell.eyebrow")}
    localeLinks={localeLinks}
    title={currentExample.title}
  />

  <section class={styles["surface"]}>
    <div class={styles["contentGrid"]}>
      <ExplorerStagePanel
        description={currentExample.description}
        placeholder={Astro.locals.t("explorer.stage.placeholder")}
        title={currentExample.title}
      />
      <ExplorerExampleRail
        currentExampleId={currentExample.id}
        examples={examples}
      />
      <ExplorerCodePanel
        placeholder={Astro.locals.t("explorer.code.placeholder")}
      />
    </div>
  </section>
</div>
