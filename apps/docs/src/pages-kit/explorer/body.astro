---
import {
  DEFAULT_EXPLORER_EXAMPLE_ID,
  type ExplorerExampleId,
  buildExplorerExamples,
  buildExplorerLocaleLinks,
  readExplorerExample,
} from "./content";
import {
  ExplorerExampleRail,
  ExplorerStagePanel,
  ExplorerTopbar,
} from "#/components/explorer";
import HostConcurrencyCode from "#/components/explorer/host-concurrency-code.astro";
import type { SiteLocale } from "#site";
import { docsHomeLink } from "#/pages-kit/docs-home-link";
import styles from "#/components/explorer/explorer.module.css";

const { currentExampleId = DEFAULT_EXPLORER_EXAMPLE_ID, locale } =
  Astro.props as {
    currentExampleId?: ExplorerExampleId;
    locale: SiteLocale;
  };
const examples = buildExplorerExamples(locale, (key) => Astro.locals.t(key));
const currentExample = readExplorerExample(currentExampleId, examples);
const localeLinks = buildExplorerLocaleLinks(currentExample.id, locale);
const stage = buildExplorerStage(currentExample);
const stagePanelProps = {
  description: currentExample.description,
  guideRows: currentExample.guideRows,
  stage,
  title: currentExample.title,
};

function buildExplorerStage(example: (typeof examples)[number]) {
  switch (example.stage) {
    case "host-concurrency":
      return {
        codeBlockId: `explorer-${example.id}-code`,
        kind: example.stage,
      };
  }
}
---

<div class={styles["root"]}>
  <ExplorerTopbar
    brandHref={docsHomeLink(locale)}
    brandLabel="shajara"
    explorerLabel={Astro.locals.t("explorer.shell.eyebrow")}
    localeLinks={localeLinks}
    title={currentExample.title}
  />

  <section class={styles["surface"]}>
    <div class={styles["contentGrid"]}>
      <ExplorerStagePanel client:load {...stagePanelProps}>
        {stage.kind === "host-concurrency" && (
          <HostConcurrencyCode id={stage.codeBlockId} />
        )}
      </ExplorerStagePanel>
      <ExplorerExampleRail
        currentExampleId={currentExample.id}
        examples={examples}
      />
    </div>
  </section>
</div>
