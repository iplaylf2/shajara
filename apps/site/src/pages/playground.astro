---
import SolidCounter from "#/components/solid-counter";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>shajara playground</title>
    <style>
      :root {
        color: #111827;
        background: #f3f4f6;
        font-family:
          "Iowan Old Style", "Palatino Linotype", "URW Palladio L", serif;
      }

      body {
        margin: 0;
      }

      main {
        box-sizing: border-box;
        display: grid;
        gap: 1.5rem;
        margin: 0 auto;
        max-width: 48rem;
        min-height: 100vh;
        padding: 4rem 1.5rem;
        place-content: center;
      }

      h1,
      p {
        margin: 0;
      }

      a {
        color: inherit;
      }
    </style>
  </head>
  <body>
    <main>
      <p><a href="/">Back to docs</a></p>
      <h1>Solid is wired into Astro.</h1>
      <p>
        Keep this page small and disposable. It exists to prove the integration
        works before real interactive examples arrive.
      </p>
      <SolidCounter client:load />
    </main>
  </body>
</html>
