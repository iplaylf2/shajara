{
  "name": "shajara",
  "private": true,
  "homepage": "https://iplaylf2.github.io/shajara",
  "author": {
    "name": "iplaylf2",
    "url": "https://github.com/iplaylf2"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "depcruise": "shajara-forge depcruise",
    "format": "oxfmt --write .",
    "lint": "pnpm -r exec oxlint --config oxlint.config.ts",
    "pack:license": "shajara-forge pack:license",
    "release": "changeset publish",
    "spellcheck": "cspell-cli .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@shajara/forge": "workspace:^",
    "@shajara/presets": "workspace:^",
    "@types/node": "catalog:",
    "cspell-cli": "^10.0.1",
    "dependency-cruiser": "catalog:",
    "knip": "^6.26.0",
    "oxfmt": "^0.58.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.1.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "packageManager": "pnpm@11.11.0"
}
