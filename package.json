{
  "name": "shajara",
  "private": true,
  "homepage": "https://iplaylf2.github.io/shajara",
  "author": {
    "name": "iplaylf2",
    "url": "https://github.com/iplaylf2"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "depcruise": "shajara-forge depcruise",
    "format": "oxfmt --write .",
    "lint": "oxlint --report-unused-disable-directives-severity error",
    "release": "changeset publish",
    "spellcheck": "cspell-cli .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@shajara/forge": "workspace:^",
    "@shajara/presets": "workspace:^",
    "@types/node": "catalog:",
    "cspell-cli": "^10.3.0",
    "dependency-cruiser": "catalog:",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
