{
  "name": "shajara",
  "workspaces": [
    "internal/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At --topological run build",
    "format": "yarn run oxfmt --write .",
    "lint": "yarn workspaces foreach -Ap run lint",
    "pack:license": "node ./scripts/pack-license.mjs",
    "spellcheck": "yarn cspell-cli .",
    "typecheck": "yarn workspaces foreach -Ap run typecheck"
  },
  "devDependencies": {
    "cspell-cli": "git+https://github.com/streetsidesoftware/cspell-cli.git",
    "oxfmt": "^0.44.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "dependenciesMeta": {
    "oxfmt": {
      "unplugged": true
    },
    "oxlint": {
      "unplugged": true
    },
    "tinypool": {
      "unplugged": true
    }
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "yarn@4.13.0"
}
