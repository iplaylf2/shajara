{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "paths": {
      "#src/*": ["./src/*"]
    },
    "rootDir": "./src",
    "types": ["node"]
  },
  "extends": "@shajara/presets/tsconfig.shared.json",
  "include": ["src/**/*.ts"]
}
